# Reference for the environment variables to set in Coolify's environment
# panel for the frontend resource. Never commit a real .env.

# Build-time only (inlined into every page, since all data fetching happens
# in getStaticProps at `next build` time — see lib/laravel.ts). Set this as a
# Coolify "Build Variable" / Docker build arg, not just a runtime env var: a
# runtime-only NEXT_PUBLIC_* is inlined as an empty string and every request
# to the API fails silently, at build time, page by page.
#
# Must point at routes/api.php's prefix, i.e. include the trailing /api:
NEXT_PUBLIC_API_URL=https://api.example.com/api
