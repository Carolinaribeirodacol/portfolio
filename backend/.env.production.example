# Reference for the environment variables to set in Coolify's environment
# panel for the backend resource. Never commit a real .env.

APP_NAME=Portfolio
APP_ENV=production
APP_KEY=                      # generate locally with: php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://api.example.com

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# stderr, not "single": logs must reach `docker logs` / Coolify's log viewer.
# A file inside storage/logs dies with the container and is invisible to the panel.
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# --- Database ---
# Point at a Coolify-managed database (or an external one). SQLite also works
# for a low-traffic single-container app, but has no place to persist across
# deploys unless database/database.sqlite is put on the same volume as storage/.
DB_CONNECTION=mysql
DB_HOST=                      # Internal host of the database resource
DB_PORT=3306
DB_DATABASE=portfolio
DB_USERNAME=portfolio
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database

BROADCAST_CONNECTION=log
MAIL_MAILER=log

# --- File storage ---
# Local disk works, but storage/app is only durable if it sits on the volume
# declared in docker-compose.yml (see the `storage` volume). Switch to S3 (or
# a self-hosted equivalent) instead if the container may ever run without
# that volume attached.
FILESYSTEM_DISK=local
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_ENDPOINT=
# AWS_URL=
# AWS_USE_PATH_STYLE_ENDPOINT=false

# CORS — the Next.js frontend origin allowed to call this API (config/cors.php)
FRONTEND_URL=https://example.com
