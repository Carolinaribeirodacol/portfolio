# Reference for the environment variables to set in Coolify's environment
# panel for the backend resource. Never commit a real .env.

APP_NAME=Portfolio
APP_ENV=production
APP_KEY=                      # generate locally with: php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://api.example.com

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# stderr, not "single": logs must reach `docker logs` / Coolify's log viewer.
# A file inside storage/logs dies with the container and is invisible to the panel.
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# --- Database ---
# Shared Postgres from the "shared-infra" Coolify project (same instance
# rukado_api uses). This app gets its own role + database on it — never the
# shared "postgres" superuser — so a compromise here can't touch other apps'
# data. Requires "Connect to Predefined Network" enabled on this resource so
# the container can reach the Postgres container by its internal name.
DB_CONNECTION=pgsql
DB_HOST=gmc7ohwwnwx03yev0kqfo2zy    # container name = DNS alias on the "coolify" network
DB_PORT=5432
DB_DATABASE=carolina
DB_USERNAME=carolina
DB_PASSWORD=
DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database

BROADCAST_CONNECTION=log
MAIL_MAILER=log

# --- File storage ---
# Shared SeaweedFS (S3-compatible, shared-infra Coolify project — same
# instance rukado uses, different bucket). No internal Docker network access
# between this app and SeaweedFS (they're on separate networks), so this goes
# through the public Traefik-routed URL for both API calls and served
# images — same pattern rukado-api already uses in production.
#
# Note the endpoint has NO :8333 — Coolify's UI shows that as the container's
# internal port, but the public route is Traefik on 80/443 doing Host-based
# routing to it. Including the port breaks connectivity (connection refused).
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=carolina-portfolio
AWS_ENDPOINT=http://s3-sf2y0o6dvk6em880wpzxpcz5.65.21.2.10.sslip.io
AWS_URL=http://s3-sf2y0o6dvk6em880wpzxpcz5.65.21.2.10.sslip.io/carolina-portfolio
AWS_USE_PATH_STYLE_ENDPOINT=true

# CORS — the Next.js frontend origin allowed to call this API (config/cors.php)
FRONTEND_URL=https://example.com
